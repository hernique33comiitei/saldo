<?xml version="1.0" encoding="utf-8"?>
<!-- Splash screen while the app starts (manifest: splash_screen_drawable; main.cpp
     hides it once the first page is drawn): the app icon, as on the launcher, on
     the pages' background (Breeze light). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EFF0F1"/>
        </shape>
    </item>
    <!-- Tile with the corners of data/icons/saldo.svg (rx 9 of 40). -->
    <item android:gravity="center" android:width="112dp" android:height="112dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp"/>
            <gradient android:angle="270" android:startColor="#3DD598" android:endColor="#1B9E6B"/>
        </shape>
    </item>
    <!-- The 108dp adaptive foreground shows its middle 72dp: 112 / 72 * 108 = 168. -->
    <item android:gravity="center" android:width="168dp" android:height="168dp"
          android:drawable="@drawable/ic_launcher_foreground"/>
</layer-list>
