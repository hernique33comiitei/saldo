msgstr "Entradas %1 · Saídas %2"

#: src/app/pages/TransactionsPage.qml:138
msgid "No matching transactions"
msgstr "Nenhuma transação encontrada"

#: src/app/pages/TransactionsPage.qml:140
msgid "Try another search or month."
msgstr "Tente outra busca ou outro mês."

#: src/app/pages/TransactionsPage.qml:141
msgid "Transactions appear here after a sync."
msgstr "As transações aparecem aqui depois de uma sincronização."

#: src/core/qml/BalanceChart.qml:31
msgid ""
"Saldo records your balance once a day; this chart fills in over the next "
"days."
msgstr ""
"O Saldo registra seu saldo uma vez por dia; este gráfico se completa nos "
"próximos dias."

